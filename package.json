{
  "name": "devopsfoundry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mdx,css,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "postgres": "^3.4.5",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "fumadocs-core": "^16.17.9",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-twoslash": "^3.3.0",
    "fumadocs-ui": "^16.17.9",
    "katex": "^0.19.1",
    "lucide-react": "^0.555.0",
    "mermaid": "^11.16.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "posthog-node": "^5.60.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.35.0",
    "tailwind-merge": "^3.7.0",
    "twoslash": "^0.3.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5"
  }
}
